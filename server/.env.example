# Copia este archivo como .env y completa los valores. .env NO se sube a GitHub.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL (valores por defecto de XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_pocket_chef

# Firma de los tokens de sesión: usa una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Solo en producción (Render, Hostinger, etc.)
# NODE_ENV=production
# TRUST_PROXY=true

# Unsplash: https://unsplash.com/developers -> New Application -> Access Key
# Con la clave, la portada del inicio usa una foto de Unsplash (1 petición cada 12 horas)
UNSPLASH_ACCESS_KEY=
# false: la foto de cada receta es la de TheMealDB y Unsplash solo se usa si falta
# true : la foto del detalle de la receta sale de Unsplash (1 petición por receta abierta; 50/hora en modo demo)
PREFER_UNSPLASH=false

# Traducción al español (TheMealDB solo trae las recetas en inglés)
# TRANSLATE=false desactiva la traducción y muestra todo en inglés
TRANSLATE=true
# MyMemory (gratis, sin registro): 5,000 caracteres/día; con un correo válido sube a 50,000/día
MYMEMORY_EMAIL=
# Opcional, mejor calidad: clave gratuita de DeepL (https://www.deepl.com/pro-api). Si existe, se usa en vez de MyMemory
DEEPL_API_KEY=
