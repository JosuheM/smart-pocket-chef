# Copia este archivo como .env y completa los valores. .env NO se sube a GitHub.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL (valores por defecto de XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_pocket_chef

# Firma de los tokens de sesión: usa una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Solo en producción (Render, Hostinger, etc.)
# NODE_ENV=production
# TRUST_PROXY=true

# Acceso con Google (opcional): Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth (aplicación web).
# En "Orígenes de JavaScript autorizados" agrega la URL del frontend (http://localhost:5173 y la de producción).
# Sin esta variable, el botón "Continuar con Google" no aparece y todo lo demás funciona igual.
GOOGLE_CLIENT_ID=

# Recuperar contraseña por correo (opcional). Sin SMTP_HOST, en desarrollo el enlace se imprime en la consola del servidor;
# en producción "¿Olvidaste tu contraseña?" responde que la función no está activa.
# Con Gmail: activa la verificación en dos pasos, crea una "contraseña de aplicación" y úsala como SMTP_PASS (nunca la de tu cuenta).
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_USER=tu-correo@gmail.com   SMTP_PASS=contraseña-de-aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Dirección del frontend para los enlaces de los correos (si falta, se usa CLIENT_ORIGIN)
APP_URL=

# Unsplash: https://unsplash.com/developers -> New Application -> Access Key
# Con la clave, la portada del inicio usa una foto de Unsplash (1 petición cada 12 horas)
UNSPLASH_ACCESS_KEY=
# false: la foto de cada receta es la de TheMealDB y Unsplash solo se usa si falta
# true : la foto del detalle de la receta sale de Unsplash (1 petición por receta abierta; 50/hora en modo demo)
PREFER_UNSPLASH=false

# Traducción al español (TheMealDB solo trae las recetas en inglés)
# TRANSLATE=false desactiva la traducción y muestra todo en inglés
TRANSLATE=true
# MyMemory (gratis, sin registro): 5,000 caracteres/día; con un correo válido sube a 50,000/día
MYMEMORY_EMAIL=
# Opcional, mejor calidad: clave gratuita de DeepL (https://www.deepl.com/pro-api). Si existe, se usa en vez de MyMemory
DEEPL_API_KEY=
